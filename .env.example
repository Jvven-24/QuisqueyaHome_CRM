# Contrato de configuración del CRM (T8).
#
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore y
# nunca se sube: las credenciales viven en el gestor de secretos del entorno, no
# en el repositorio.
#
# Se usa `.env` y no `.env.local` a propósito: Next.js lee los dos, pero
# `drizzle-kit` y `scripts/seed.mjs` cargan `.env` con `process.loadEnvFile`.
# Un solo archivo para todo evita que la aplicación y las migraciones apunten a
# bases distintas sin que nadie se dé cuenta.
#
# Las tres variables se leen en un solo sitio, `src/infrastructure/env.ts`. Si
# añades una, añádela también ahí y aquí — un `process.env.X` suelto es una
# variable que nadie documenta y que falla en producción, no en desarrollo.

# ============================================================================
# OPCIÓN A · Supabase local (desarrollo) — es la recomendada para el día a día
# ============================================================================
#
#   1. Abre Docker Desktop y espera a que arranque.
#   2. npm run db:up          (la primera vez descarga imágenes, tarda)
#   3. Copia el `anon key` que imprime y pégalo abajo.
#   4. npm run db:migrate && npm run db:seed
#
# La URL y la cadena de conexión son fijas, las define supabase/config.toml.
# Para volver a verlas: npm run db:status
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<lo imprime `npm run db:up`>
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Panel local (ver datos, usuarios de Auth): http://127.0.0.1:54323
# Correos de prueba (recuperación de contraseña): http://127.0.0.1:54324

# ============================================================================
# OPCIÓN B · Supabase en la nube (staging y producción)
# ============================================================================

# Panel de Supabase → Project Settings → Data API.
# URL del proyecto. Pública: la usa también el navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima. Pública por diseño — la seguridad no la da esta clave, la dan
# el RBAC del servidor (T3) y las políticas de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Botón "Connect" del panel → Connection String → **Session pooler**.
#
# NO uses "Direct connection" (`db.<ref>.supabase.co`): solo tiene registro
# IPv6, y en una red sin IPv6 fiable falla de forma intermitente. El session
# pooler responde por IPv4 y aguanta igual las sesiones largas de
# `drizzle-kit migrate` y `pg_dump`. Nunca se expone al navegador.
#
# Forma: postgresql://postgres.<ref>:CLAVE@aws-N-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
