# Contrato de configuración del CRM (T8).
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y nunca se sube: las credenciales viven en el gestor de secretos
# del entorno, no en el repositorio.
#
# Las tres variables se leen en un solo sitio, `src/infrastructure/env.ts`. Si
# añades una, añádela también ahí y aquí — un `process.env.X` suelto es una
# variable que nadie documenta y que falla en producción, no en desarrollo.

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase → Project Settings → Data API.

# URL del proyecto. Pública: la usa también el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima. Pública por diseño — la seguridad no la da esta clave, la dan
# el RBAC del servidor (T3) y las políticas de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Base de datos ----------------------------------------------------------
# Panel de Supabase → Project Settings → Database → Connection string.
#
# Usa el puerto 6543 (pooler en modo transacción) para la aplicación: es lo que
# aguanta muchas conexiones cortas. El 5432 (conexión directa) solo para
# migraciones. Nunca se expone al navegador.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
