{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxil.org/schemas/scr.schema.json",
  "title": "PXIL Screen",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "screen" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "approved", "rejected", "deprecated"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "layout": { "type": "string" },
    "components": { 
      "type": "array", 
      "items": { 
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "props": { "type": "object" }
        },
        "required": ["id", "type"]
      } 
    },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "owner": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "rel": { "type": "string" }, "href": { "type": "string" } },
        "required": ["rel", "href"]
      }
    }
  },
  "required": ["id", "type", "version", "status", "name", "components"],
  "additionalProperties": false
}
