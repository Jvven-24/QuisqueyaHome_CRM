{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxil.org/schemas/sta.schema.json",
  "title": "PXIL State",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "state" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "approved", "rejected", "deprecated"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "context": { "type": "object" },
    "transitions": { 
      "type": "array", 
      "items": { 
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "target": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["event", "target"]
      } 
    },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "owner": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "rel": { "type": "string" }, "href": { "type": "string" } },
        "required": ["rel", "href"]
      }
    }
  },
  "required": ["id", "type", "version", "status", "name", "transitions"],
  "additionalProperties": false
}
