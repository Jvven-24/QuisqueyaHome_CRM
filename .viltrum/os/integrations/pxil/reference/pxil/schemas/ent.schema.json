{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxil.org/schemas/ent.schema.json",
  "title": "PXIL Entity",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "entity" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "approved", "rejected", "deprecated"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "attributes": { 
      "type": "array", 
      "items": { 
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "required": ["name", "type"]
      } 
    },
    "relationships": { 
      "type": "array", 
      "items": { 
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "type": { "type": "string", "enum": ["one-to-one", "one-to-many", "many-to-many"] }
        },
        "required": ["target", "type"]
      } 
    },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "owner": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "rel": { "type": "string" }, "href": { "type": "string" } },
        "required": ["rel", "href"]
      }
    }
  },
  "required": ["id", "type", "version", "status", "name", "attributes"],
  "additionalProperties": false
}
