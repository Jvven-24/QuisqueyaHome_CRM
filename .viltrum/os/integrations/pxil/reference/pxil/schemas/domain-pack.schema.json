{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Domain Pack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the domain pack"
    },
    "version": {
      "type": "string",
      "description": "Version of the domain pack"
    },
    "domain": {
      "type": "string",
      "enum": ["finance", "CRM", "real estate", "generic"],
      "description": "Domain category"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of component references"
    }
  },
  "required": ["name", "version", "domain"]
}
