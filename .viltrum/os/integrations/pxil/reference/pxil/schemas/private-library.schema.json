{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Library Schema",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "source": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["21st", "custom", "external"] },
              "url": { "type": "string" },
              "author": { "type": "string" }
            },
            "required": ["type"]
          },
          "visual_attributes": {
            "type": "object",
            "properties": {
              "family": { "type": "string" },
              "style": { "type": "string" }
            }
          },
          "code": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "name", "source", "code"]
      }
    }
  },
  "required": ["components"]
}
