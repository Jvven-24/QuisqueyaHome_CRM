  "gap_rules": {
    "G01": {
      "severity": "P2",
      "text": "Falta la celda de un departamento obligatorio (por tipo de nodo o por bandera)"
    },
    "G02": {
      "severity": "P2",
      "text": "Celda n/a sin razón o sin evidencia"
    },
    "G03": {
      "severity": "P1",
      "text": "Requisito sin prueba de aceptación enlazada (verifies)"
    },
    "G04": {
      "severity": "P2",
      "text": "Pantalla sin los seis estados cubiertos por D06"
    },
    "G05": {
      "severity": "P2",
      "text": "Función sin contrato/entidad/integración enlazados ni n/a justificado en D10"
    },
    "G06": {
      "severity": "P1",
      "text": "Decisión de reutilización adopt/adapt sin candidato de licencia permitida y verificada"
    },
    "G07": {
      "severity": "P1",
      "text": "Candidato con licencia bloqueada o a revisión humana propuesto para adopt/adapt"
    },
    "G08": {
      "severity": "P3",
      "text": "Nodo huérfano: sin padre ni contenido y no es una meta"
    },
    "G09": {
      "severity": "P1",
      "text": "Ciclo en depends_on"
    },
    "G10": {
      "severity": "P1",
      "text": "Celda validado/hecho/n/a sin revisor independiente (distinto del productor) o sin referencia de revisión (P4)"
    },
    "G11": {
      "severity": "P2",
      "text": "Referencia a un nodo que no existe"
    },
    "G12": {
      "severity": "P2",
      "text": "Nodo sin criterio de aceptación verificable"
    },
    "G13": {
      "severity": "P2",
      "text": "Formato o vocabulario inválido: estado, tipo, riesgo, prioridad, id duplicado o ausente, departamento mal escrito"
    },
    "G14": {
      "severity": "P3",
      "text": "Cambio humano (overrides) sobre un campo o nodo inexistente"
    },
    "G15": {
      "severity": "P3",
      "text": "Nodo sin explicación en lenguaje simple (plain) para la lectura de una persona no técnica"
    },
    "G16": {
      "severity": "P2",
      "text": "Comunicación incoherente: un departamento declara entregar a otro (o necesitar de otro) que no tiene celda para ese nodo"
    },
    "G17": {
      "severity": "P2",
      "text": "Celda obligatoria todavía en pendiente: el departamento aún no aportó"
    },
    "G18": {
      "severity": "P2",
      "text": "Celda bloqueada: requiere una decisión o un desbloqueo"
    },
    "G19": {
      "severity": "P2",
      "text": "Celda hecho sin evidencia verificable"
    },
    "G20": {
      "severity": "P2",
      "text": "Función o pantalla sin comportamientos hijos (estados, validaciones, errores) ni justificación"
    },
    "G21": {
      "severity": "P3",
      "text": "Comunicación no recíproca: A declara entregar a B pero B no declara necesitar de A (o al revés)"
    },
    "G22": {
      "severity": "P2",
      "text": "Decisión build sin justificar la búsqueda previa de algo existente (P0)"
    },
    "G23": {
      "severity": "P2",
      "text": "Celda cerrada antes de un cambio humano en su nodo (o en uno enlazado): hay que revalidarla"
    },
    "G24": {
      "severity": "P1",
      "text": "Posible secreto dentro del mapa"
    },
    "G25": {
      "severity": "P3",
      "text": "Nodo cuyo código fuente ya no existe (stale_source): confirmar si se retira o se reubica"
    }
  },
