{
  "name": "quisqueya-home-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prod:build": "node scripts/prod.mjs build",
    "prod:start": "node scripts/prod.mjs start",
    "vps": "node scripts/vps-dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "node scripts/test-db/run.mjs",
    "test:db:guards": "node --test scripts/test-db/guards.mjs",
    "test:db:mutation:alias": "node scripts/test-db/run.mjs --mutation=alias",
    "test:db:mutation:boolean": "node scripts/test-db/run.mjs --mutation=boolean",
    "test:db:mutation:venta-unica": "node scripts/test-db/run.mjs --mutation=venta-unica",
    "test:db:mutation:negocios-join": "node scripts/test-db/run.mjs --mutation=negocios-join",
    "spec:check": "node scripts/spec/check.mjs",
    "avance": "node scripts/spec/avance.mjs",
    "outbox:worker": "node scripts/outbox-worker.mjs",
    "test:spec": "node --test scripts/spec/check.test.mjs scripts/spec/avance.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env scripts/seed/index.ts",
    "db:seed:clean": "node --env-file=.env scripts/seed/limpiar.ts",
    "db:up": "npx --yes supabase@2.116.0 start",
    "db:down": "npx --yes supabase@2.116.0 stop",
    "db:status": "npx --yes supabase@2.116.0 status",
    "db:reset": "npx --yes supabase@2.116.0 db reset && npm run db:migrate && npm run db:seed",
    "db:seed:test": "QH_TEST_SEED=1 node --env-file=.env scripts/seed-test.ts",
    "test:seed": "node --test scripts/seed-test.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "^15.1.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  }
}
